  23:Core/Src/main.c ****   u8g2_SetFont(u8g2, u8g2_font_helvB12_tr);
  24:Core/Src/main.c ****   const char *text = "Martin Grani";
  25:Core/Src/main.c ****   int16_t text_width = u8g2_GetStrWidth(u8g2, text);
  26:Core/Src/main.c ****   uint16_t middle_screen_pos = (128/2) - (text_width/2);
  27:Core/Src/main.c **** 
  28:Core/Src/main.c ****   char buf[16];
  29:Core/Src/main.c **** 
  30:Core/Src/main.c ****   u8g2_ClearBuffer(u8g2);
  31:Core/Src/main.c ****   u8g2_DrawStr(u8g2, middle_screen_pos, 38, text);
  32:Core/Src/main.c ****   u8g2_SendBuffer(u8g2);
