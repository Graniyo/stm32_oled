  37:Core/Src/main.c ****   int16_t temperature = 0;
  38:Core/Src/main.c ****   int16_t humidity = 0;
  39:Core/Src/main.c ****   int dht_status = 0;
  40:Core/Src/main.c **** 
  41:Core/Src/main.c ****   while (1) {
  42:Core/Src/main.c ****     onboard_led_toggle();
  43:Core/Src/main.c **** 
  44:Core/Src/main.c ****     // Les DHT22-data
  45:Core/Src/main.c ****     dht_status = get_dht22_data(&temperature, &humidity);
  46:Core/Src/main.c **** 
  47:Core/Src/main.c ****     u8g2_ClearBuffer(u8g2);
  48:Core/Src/main.c **** 
  49:Core/Src/main.c ****     if (dht_status == 0) {
  50:Core/Src/main.c ****       // Vis temperatur (tiendeler -> grader)
  51:Core/Src/main.c ****       snprintf(buf, sizeof(buf), "T: %d.%d C", temperature / 10, temperature % 10);
  52:Core/Src/main.c ****       u8g2_DrawStr(u8g2, 0, 20, buf);
  53:Core/Src/main.c **** 
  54:Core/Src/main.c ****       // Vis fuktighet
  55:Core/Src/main.c ****       snprintf(buf, sizeof(buf), "H: %d.%d %%", humidity / 10, humidity % 10);
  56:Core/Src/main.c ****       u8g2_DrawStr(u8g2, 0, 40, buf);
  57:Core/Src/main.c ****     } else if (dht_status == -1) {
  58:Core/Src/main.c ****       u8g2_DrawStr(u8g2, 0, 30, "DHT22: Timeout");
  59:Core/Src/main.c ****     } else {
  60:Core/Src/main.c ****       u8g2_DrawStr(u8g2, 0, 30, "DHT22: CRC feil");
  61:Core/Src/main.c ****     }
  62:Core/Src/main.c **** 
  63:Core/Src/main.c ****     u8g2_SendBuffer(u8g2);
  64:Core/Src/main.c **** 
  65:Core/Src/main.c ****     // DHT22 krever minst 2 sekunder mellom avlesninger
  66:Core/Src/main.c ****     bare_delay_ms(2000);
  67:Core/Src/main.c ****   }
  68:Core/Src/main.c **** }
