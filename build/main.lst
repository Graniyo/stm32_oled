  33:Core/Src/main.c **** 
  34:Core/Src/main.c **** 
  35:Core/Src/main.c **** 
  36:Core/Src/main.c **** 
  37:Core/Src/main.c ****   int16_t temperature = 0;
  38:Core/Src/main.c ****   int16_t humidity = 0;
  39:Core/Src/main.c ****   int dht_status = 0;
  40:Core/Src/main.c ****   int dht_status_struct = 0;
  41:Core/Src/main.c **** 
  42:Core/Src/main.c ****   dht22 sensor;
  43:Core/Src/main.c **** 
  44:Core/Src/main.c ****   while (1) {
  45:Core/Src/main.c ****     onboard_led_toggle();
  46:Core/Src/main.c **** 
  47:Core/Src/main.c ****     // Les DHT22-data
  48:Core/Src/main.c ****     //dht_status = get_dht22_data(&temperature, &humidity);
  49:Core/Src/main.c ****     dht_status_struct = get_dht22_data_struct(&sensor);
  50:Core/Src/main.c **** 
  51:Core/Src/main.c ****     u8g2_ClearBuffer(u8g2);
  52:Core/Src/main.c **** 
  53:Core/Src/main.c ****     if (dht_status_struct == 0) {
  54:Core/Src/main.c ****       // Vis temperatur (tiendeler -> grader)
  55:Core/Src/main.c ****       snprintf(buf, sizeof(buf), "T: %d.%d C", sensor.temperature / 10, sensor.temperature % 10);
  56:Core/Src/main.c ****       u8g2_DrawStr(u8g2, 0, 20, buf);
  57:Core/Src/main.c **** 
  58:Core/Src/main.c ****       // Vis fuktighet
  59:Core/Src/main.c ****       snprintf(buf, sizeof(buf), "H: %d.%d %%", sensor.humidity / 10, sensor.humidity % 10);
  60:Core/Src/main.c ****       u8g2_DrawStr(u8g2, 0, 40, buf);
  61:Core/Src/main.c ****     } else if (dht_status_struct == -1) {
  62:Core/Src/main.c ****       u8g2_DrawStr(u8g2, 0, 30, "DHT22: Timeout");
  63:Core/Src/main.c ****     } else {
  64:Core/Src/main.c ****       u8g2_DrawStr(u8g2, 0, 30, "DHT22: CRC feil");
  65:Core/Src/main.c ****     }
  66:Core/Src/main.c **** 
  67:Core/Src/main.c ****     u8g2_SendBuffer(u8g2);
  68:Core/Src/main.c **** 
  69:Core/Src/main.c ****     // DHT22 krever minst 2 sekunder mellom avlesninger
  70:Core/Src/main.c ****     bare_delay_ms(2000);
  71:Core/Src/main.c ****   }
  72:Core/Src/main.c **** }
